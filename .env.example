# Local development defaults to Ollama.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_BATCH=32
# Ollama automatically offloads to the GPU when available.
# Set OLLAMA_NUM_GPU=0 only when CPU inference is required.

# Required when LLM_PROVIDER=openrouter.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Optional OpenRouter attribution headers.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=PromptScope
